{
  "expo": {
    "name": "PointBreak Driver",
    "slug": "pointbreak-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "pointbreakdriver",
    "icon": "./assets-driver/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a0a00"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pointbreak.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PointBreak Driver uses your location to navigate to passengers.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "PointBreak Driver uses your location to track active rides."
      }
    },
    "android": {
      "package": "com.pointbreak.driver",
      "versionCode": 1,
      "label": "PB Captain",
      "adaptiveIcon": {
        "foregroundImage": "./assets-driver/adaptive-icon.png",
        "backgroundColor": "#1a0a00"
      },
      "icon": "./assets-driver/icon.png",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "INTERNET",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "SYSTEM_ALERT_WINDOW"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "windowSoftInputMode": "adjustResize",
      "useNextNotificationsApi": true
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "allowBackup": true
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PointBreak Driver uses your location to navigate to passengers.",
          "locationAlwaysAndWhenInUsePermission": "PointBreak Driver uses your location to track active rides."
        }
      ],
      "expo-splash-screen",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets-driver/icon.png",
          "color": "#F59E0B"
        }
      ]
    ],
    "extra": {
      "buildTarget": "driver",
      "eas": {
        "projectId": "7cd97e01-446e-4d4c-9358-ad3e13153e64"
      }
    },
    "owner": "andrews94"
  }
}
