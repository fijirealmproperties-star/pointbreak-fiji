{
  "name": "pointbreak-rides-fiji",
  "version": "1.0.0",
  "description": "PointBreak Rides Fiji - Uber-style ride & boat-hailing across every Fijian island",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run mobile\"",
    "web": "concurrently \"npm run server\" \"npm run web:serve\"",
    "web:serve": "cd web && npx serve -l 8080 -s .",
    "server": "node server/index.js",
    "mobile": "cd mobile && npx expo start",
    "install:all": "npm install && cd mobile && npm install"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "socket.io": "^4.7.2",
    "sql.js": "^1.14.1",
    "uuid": "^9.0.0",
    "zod": "^3.25.76"
  }
}
